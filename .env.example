# Персональные данные из Moodle.
MOODLE_LOGIN=your-moodle-login
MOODLE_FULL_NAME="Фамилия Имя Отчество"

# Токен авторизации нужно сгенерировать: openssl rand -hex 32
API_TOKEN=replace-with-a-long-random-token

# Приложение использует отдельную учебную роль PostgreSQL
DATABASE_URL=postgresql://todo_app:change_me@localhost:5432/todo_students
PORT=3000
NODE_ENV=development

# Адрес Vite dev
CORS_ORIGIN=http://localhost:5173
